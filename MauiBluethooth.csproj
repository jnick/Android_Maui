<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>MauiBluethooth</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>MauiBluethooth</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.mauibluethooth</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<!-- Минимальная версия Android для этого проекта.
		     Поднята с 21.0 до 24.0 (Android 7.0), потому что CameraX требует API 21+,
		     а актуальная версия пакета Xamarin.AndroidX.Camera 1.6.x рассчитана на API 24+.
		     Устройства ниже Android 7 приложение теперь просто не установят -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- Приложение проверялось ТОЛЬКО на реальных Android-устройствах с 64-битным ARM.
		     Ограничиваем набор ABI одним значением: в APK попадёт только lib/arm64-v8a,
		     и ни на 32-битном устройстве, ни на x86_64-эмуляторе приложение не запустится.
		     Это сделано намеренно — собирать и тестировать под эмулятором мы не планируем.
		     Именно RuntimeIdentifiers, а не AndroidSupportedAbis: в .NET 10 Android-сабмитчер
		     объявил AndroidSupportedAbis устаревшим (XA0036) и просит использовать это свойство.
		     Побочный эффект: RuntimeIdentifiers участвует в восстановлении пакетов,
		     поэтому лишний ABI не качается, а APK получается arm64-only -->
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64</RuntimeIdentifiers>

		<!-- Версии OpenCV фиксируем явно, потому что управляемая сборка OpenCvSharp и нативная
		     библиотека ОБЯЗАНЫ совпадать по версии: несовпадение даст EntryPointNotFoundException
		     при вызове любого метода, добавленного в одной из сборок, но отсутствующего в другой -->
		<OpenCvSharpVersion>4.13.0.20260627</OpenCvSharpVersion>
		<OpenCvSharpAndroidNativeVersion>4.13.0.45</OpenCvSharpAndroidNativeVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

		<!-- Управляемая часть OpenCV — общая для обеих платформ.
		     Это только P/Invoke-обёртки над нативной libOpenCvSharpExtern: без нативной
		     библиотеки пакет бесполезен, её подключаем отдельно для каждой платформы -->
		<PackageReference Include="OpenCvSharp4" Version="$(OpenCvSharpVersion)" />
	</ItemGroup>

	<!-- Нативная библиотека OpenCV для Windows. Берём ПОЛНЫЙ пакет, а не .slim:
	     .slim собран без модуля dnn, а нам нужен OpenCvSharp.Dnn.Net для запуска ONNX-моделей.
	     Управляемый API мы используем тот же самый, что и на Android, поэтому код переносится один в один -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="$(OpenCvSharpVersion)" />
	</ItemGroup>

	<!-- Нативная библиотека OpenCV для Android. Официального пакета OpenCvSharp под Android не существует,
	     поэтому используем community-сборку Sdcb.OpenCvSharp4.mini.
	     Нам нужен именно mini, а не full: в нём только core/imgproc/imgcodecs/dnn,
	     а модуль objdetect (FaceDetectorYN, CascadeClassifier, ArUco) нам не нужен —
	     декод выходов YuNet мы пишем сами в YuNetModel.cs, что заодно объясняет алгоритм студенту -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.android-arm64" Version="$(OpenCvSharpAndroidNativeVersion)" />
	</ItemGroup>

	<!-- Пакеты камеры подключаются ТОЛЬКО для Android-сборки.
	     Условие нужно, потому что эти Xamarin.AndroidX-пакеты не имеют сборок под net10.0-windows:
	     при сборке Windows они вызвали бы ошибку восстановления пакетов -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">

		<!-- Camera2: мост к системному Camera2 API. Через него CameraX получает список камер,
		     проверяет их наличие (HasCamera) и открывает устройство -->
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />

		<!-- Core: базовые классы CameraX — IImageProxy (сырой кадр), ImageAnalysis и Preview (use case'ы).
		     Именно отсюда берутся классы, которые мы используем в AndroidCameraService -->
		<PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.6.2" />

		<!-- Lifecycle: привязка камеры к жизненному циклу Activity.
		     Без него невозможно вызвать BindToLifecycle, то есть открыть камеру -->
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />

		<!-- View: нативный контрол PreviewView, в который CameraX выводит картинку.
		     Его наш CameraPreviewHandler подставляет вместо абстрактного MAUI-контрола -->
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />

		<!-- Collection.Ktx и Fragment.Ktx: расширения Kotlin-коллекций и Fragment'ов.
		     Подключаются вместе с CameraX, потому что тот использует их внутри себя,
		     а при отсутствии одной из зависимостей сборка Android не проходит -->
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>

	<!-- ===================================================================================
	     Проверка нативной библиотеки OpenCV.

	     Зачем нужен этот таргет. Ниже закомментировано, что пакет Sdcb.OpenCvSharp4.mini
	     подключает libOpenCvSharpExtern.so в APK самостоятельно — ручной элемент
	     AndroidNativeLibrary не нужен и только вызывал дубликат (XA4301).

	     Но остаётся неприятный сценарий: если пакет не восстановился, версия сменилась
	     или путь внутри пакета изменился, то .so молча не попадёт в сборку. Приложение
	     запустится, камера включится, а первый же вызов Cv2 упадёт с DllNotFoundException
	     без понятной причины. Поэтому проверяем файл сразу после восстановления пакетов
	     и роняем сборку с внятным текстом.
	     =================================================================================== -->

	<!-- Путь к нативной библиотеке внутри NuGet-кеша. Версия вынесена в свойство выше -->
	<PropertyGroup>
		<OpenCvSharpAndroidNativeLibrary>$(NuGetPackageRoot)sdcb.opencvsharp4.mini.runtime.android-arm64\$(OpenCvSharpAndroidNativeVersion)\runtimes\linux-arm64\native\libOpenCvSharpExtern.so</OpenCvSharpAndroidNativeLibrary>
	</PropertyGroup>

	<Target Name="OpenCvSharpAndroidNativeCheck"
			AfterTargets="Restore"
			BeforeTargets="ResolveReferences"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<Error Condition="!Exists('$(OpenCvSharpAndroidNativeLibrary)')"
			   Text="Не найдена нативная библиотека OpenCV: $(OpenCvSharpAndroidNativeLibrary). Выполните «dotnet restore» и проверьте, что пакет Sdcb.OpenCvSharp4.mini.runtime.android-arm64 версии $(OpenCvSharpAndroidNativeVersion) скачался." />
		<Message Importance="high" Text="OpenCV: нативная библиотека на месте — $(OpenCvSharpAndroidNativeLibrary)" />
	</Target>

	<!-- Известное ограничение, которое мы сознательно не решаем.
	     Сборка выдаёт предупреждение XA0141: у libOpenCvSharpExtern.so из пакета Sdcb
	     выравнивание сегментов ELF равно 4096 байт, а для Android 16 требуется 65536.
	     Проверено разбором ELF: все три PT_LOAD имеют align 0x1000.
	     Последствие: на устройствах с Android 16 библиотека может не загрузиться.
	     Обойти это в своём коде нельзя — нужно ждать пересборки пакета автором.
	     Для Android 15 и ниже всё работает. Несовместимость пока только теоретическая:
	     в пользовательском Android-версия API 36, а сам пакет собран под bionic/ARM64 -->

</Project>
