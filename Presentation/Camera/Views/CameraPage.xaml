<?xml version="1.0" encoding="utf-8" ?>
<!--
    Экран камеры: живое видео с камеры + оверлей с рамками вокруг найденных объектов + панель управления.

    Пространства имён, объявленные на корневом элементе ContentPage:
      xmlns        — пространство MAUI по умолчанию: Grid, Label, Button, Picker, GraphicsView
      xmlns:x      — расширения XAML: x:Class, x:Name, x:DataType
      xmlns:camera — наше пространство имён, чтобы использовать собственный контрол CameraPreview
      xmlns:vm     — пространство имён ViewModel'ов, нужно для x:DataType

    Остальные атрибуты корневого элемента:
      x:Class="MauiBluethooth.Presentation.Camera.Views.CameraPage"
              — имя класса code-behind (CameraPage.xaml.cs), связывает XAML и код

      x:DataType="vm:CameraViewModel"
              — тип BindingContext. Включает проверку привязок ПРИ КОМПИЛЯЦИИ: опечатку в имени
                свойства XAML-компилятор найдёт сразу, а не в рантайме

      Title="Камера" — заголовок страницы (на Android показывается в панели сверху)

      BackgroundColor="Black"
              — чёрный фон: он же служит «подложкой», пока камера ещё не запущена,
                и не даёт белым полосам на нечётных пропорциях кадра

    ВНИМАНИЕ: внутри открывающего тега комментарии XML недопустимы — парсер XAML MAUI
    (XamlC) не пропускает их между атрибутами. Поэтому все пояснения вынесены сюда.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:camera="clr-namespace:MauiBluethooth.Presentation.Camera.Views"
             xmlns:vm="clr-namespace:MauiBluethooth.Presentation.Camera.ViewModels"
             x:Class="MauiBluethooth.Presentation.Camera.Views.CameraPage"
             x:DataType="vm:CameraViewModel"
             Title="Камера"
             BackgroundColor="Black">

    <!-- Корневой Grid: две строки.
         RowDefinitions="*,Auto" — «*» означает «занять всё оставшееся место» (здесь видео),
         «Auto» — «высота по содержимому» (здесь нижняя панель с кнопками) -->
    <Grid RowDefinitions="*,Auto">

        <!-- Строка 0: область видео. Внутри ещё Grid — элементы накладываются друг на друга -->
        <Grid Grid.Row="0">

            <!-- Собственно живое видео с камеры.
                 Это наш кроссплатформенный контрол, который через handler подставляет
                 нативный элемент: PreviewView на Android, MediaPlayerElement на Windows.

                 x:Name="Preview"            — даём имя, чтобы обращаться к нему из кода страницы
                 CameraService="{Binding CameraService}"
                                         — передаём камерный сервис из ViewModel;
                                           handler возьмёт у него нативный элемент предпросмотра
                 HorizontalOptions/VerticalOptions = FillAndExpand
                                         — растягиваем видео на всё доступное место;
                                           наполнение по обеим осям обязательно, иначе элемент
                                           займёт лишь часть строки и оверлей сместится -->
            <camera:CameraPreview x:Name="Preview"
                                   CameraService="{Binding CameraService}"
                                   HorizontalOptions="FillAndExpand"
                                   VerticalOptions="FillAndExpand" />

            <!-- Поверх видео — слой для рисования рамок вокруг объектов.
                 GraphicsView — универсальный холст MAUI, умеет рисовать примитивами
                 (линии, прямоугольники, текст).

                 x:Name="OverlayView"      — имя нужно странице, чтобы вызвать Invalidate()
                                             при смене геометрии кадра
                 InputTransparent="True"  — оверлей не перехватывает касания. Без этого нажатия
                                             (в том числе системный жест «назад») не доходили бы до страницы
                 FillAndExpand            — растягиваем на ту же область, что и видео: только при
                                             одинаковом размере оверлей совпадёт с картинкой по координатам -->
            <GraphicsView x:Name="OverlayView"
                           InputTransparent="True"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="FillAndExpand" />

            <!-- Крутилка загрузки поверх видео на время запуска камеры.
                 IsRunning="{Binding IsStarting}" — крутится ровно пока ViewModel запускает камеру
                 Color="White"                   — заметен и на чёрном фоне, и на тёмной картинке камеры
                 Center/Center                  — центрируем в области видео -->
            <ActivityIndicator IsRunning="{Binding IsStarting}"
                               Color="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

        <!-- Строка 1: нижняя панель управления.
             Padding="16"  — отступы от краёв, чтобы элементы не липли к границам экрана
             Spacing="8"   — промежуток между элементами панели
             BackgroundColor="Black" — визуально отделяет панель от яркой картинки камеры -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="16"
                             Spacing="8"
                             BackgroundColor="Black">

            <!-- Выбор камеры из списка (задняя/фронтальная, либо список веб-камер в Windows).
                 Показывается только когда камер больше одной — этим управляет ViewModel.

                 ItemsSource="{Binding CameraOptions}"
                       — источник данных: ObservableCollection<CameraOption> из ViewModel
                 SelectedItem="{Binding SelectedCamera}"
                       — двусторонняя привязка: когда пользователь выберет камеру,
                         сеттер SelectedCamera переключит её в сервисе
                 IsVisible="{Binding IsCameraPickerVisible}"
                       — прячем Picker, если камера всего одна (выбирать нечего)
                 TextColor/TitleColor = White
                       — стандартный Picker чёрный, и на чёрном фоне его бы не было видно -->
            <Picker Title="Камера"
                    ItemsSource="{Binding CameraOptions}"
                    SelectedItem="{Binding SelectedCamera}"
                    IsVisible="{Binding IsCameraPickerVisible}"
                    TextColor="White"
                    TitleColor="White" />

            <!-- Текстовый статус: «Запуск камеры...», «Камера запущена», текст ошибки и т.д.
                 TextColor="White"                 — белый текст на чёрной панели
                 HorizontalTextAlignment="Center" — по центру так статус читается легче -->
            <Label Text="{Binding StatusText}"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <!-- Кнопка остановки камеры.
                 Command="{Binding StopCameraCommand}"
                       — команда сгенерирована атрибутом [RelayCommand] во ViewModel
                 IsVisible="{Binding IsRunning}"
                       — прячем кнопку, когда камера и так не запущена -->
            <Button Text="Остановить"
                    Command="{Binding StopCameraCommand}"
                    IsVisible="{Binding IsRunning}" />

            <!-- Кнопка открытия системных настроек.
                 Нужна, когда пользователь уже отказал в доступе к камере: система больше не покажет
                 диалог, и разрешение можно выдать только вручную.

                 Command="{Binding OpenSettingsCommand}"
                       — команда вызывает AppInfo.ShowSettingsUI()
                 IsVisible="{Binding ShowPermissionSettings}"
                       — показываем только при отказе в разрешении (флаг выставляет ViewModel) -->
            <Button Text="Открыть настройки"
                    Command="{Binding OpenSettingsCommand}"
                    IsVisible="{Binding ShowPermissionSettings}" />

            <!-- ===== Блок управления распознаванием ===== -->

            <!-- Выбор модели распознавания из выпадающего списка.
                 ItemsSource="{Binding DetectionModels}"
                       — список моделей из каталога, приходит в ViewModel
                 ItemDisplayBinding="{Binding DisplayName, StringFormat='{0}'}"
                       — в списке показываем только читаемое название («Лицо · YuNet · int8»),
                         а не технический идентификатор вида «yunet-int8»
                 SelectedItem="{Binding SelectedDetectionModel}"
                       — двусторонняя привязка: выбор пользователя вызывает смену модели.
                         Сама смена асинхронная, поэтому интерфейс не блокируется
                 IsEnabled="{Binding IsModelPickerEnabled}"
                       — на время загрузки сети список блокируется: две параллельные
                         загрузки моделей это лишняя память и лишние секунды работы -->
            <Picker Title="Модель распознавания"
                    ItemsSource="{Binding DetectionModels}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedItem="{Binding SelectedDetectionModel}"
                    IsVisible="{Binding IsDetectionEnabled}"
                    TextColor="White"
                    TitleColor="White" />

            <!-- Переключатель распознавания: включить или выключить вычисления.
                 Когда выключено, кадры не доходят до OpenCV вообще, а не просто
                 игнорируются результаты. Экономит батарею -->
            <HorizontalStackLayout Spacing="8"
                                    HorizontalOptions="Center">
                <Switch IsToggled="{Binding IsDetectionEnabled}" />
                <Label Text="Распознавание"
                       TextColor="White"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Ползунок порога уверенности.
                 Показывает, какие рамки считаются достаточно уверенными.
                 Значение по умолчанию 0,5. MinimumValue/MaximumValue совпадают
                 с границами в ObjectDetector: ползунок физически не даст
                 выставить бессмысленные значения -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="Порог"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Slider Grid.Column="1"
                        Minimum="{Binding MinScoreThreshold}"
                        Maximum="{Binding MaxScoreThreshold}"
                        Value="{Binding ScoreThreshold}"
                        IsVisible="{Binding IsDetectionEnabled}" />
            </Grid>

            <!-- Подпись под ползунком: текущее значение в процентах.
                 Проценты читаются человеку, а модель работает в долях единицы,
                 поэтому конвертация в текст должна быть явной -->
            <Label Text="{Binding ScoreThreshold, StringFormat='Порог: {0:P0}'}"
                   TextColor="Gray"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding IsDetectionEnabled}" />

            <!-- Строка состояния распознавания: сколько найдено и с какой скоростью.
                 FPS — главный показатель, насколько модель тяжела для телефона -->
            <Label Text="{Binding DetectionStatusText}"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding DetectionFps, StringFormat='{0:F1} кадр/с'}"
                   TextColor="Gray"
                   FontSize="12"
                   HorizontalTextAlignment="Center" />

            <!-- Индикатор загрузки модели.
                 Пока модель читается с диска, список моделей заблокирован,
                 а этот элемент объясняет пользователю, почему нельзя выбрать другую -->
            <ActivityIndicator IsRunning="{Binding IsModelLoading}"
                               Color="White"
                               IsVisible="{Binding IsModelLoading}" />

            <!-- Текст ошибки модели: несовместимость файла, нет модели в ресурсах и тому подобное.
                 Отдельная метка, а не часть StatusText, потому что ошибка должна оставаться
                 на экране, пока её не сменит успешная загрузка -->
            <Label Text="{Binding ModelErrorText}"
                   TextColor="OrangeRed"
                   FontSize="12"
                   IsVisible="{Binding HasModelError}" />

            <!-- Переходы на страницы диагностики и заданий.
                 Команды, а не события Clicked: в этом проекте вся навигация
                 живёт в ViewModel, а страница только связывает. Иначе страница
                 знала бы о маршрутах Shell, и её пришлось бы править при каждом
                 переименовании

                 Диагностика показывает замеры по этапам, задания — что именно
                 и с каким результатом распознано -->
            <HorizontalStackLayout Spacing="8"
                                    HorizontalOptions="Center">
                <Button Text="Диагностика"
                        FontSize="12"
                        Command="{Binding GoToDiagnosticsCommand}" />
                <Button Text="Задания"
                        FontSize="12"
                        Command="{Binding GoToTasksCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
