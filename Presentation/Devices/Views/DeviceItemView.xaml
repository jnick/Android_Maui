<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiBluethooth.Presentation.Devices.ViewModels"
             x:Class="MauiBluethooth.Presentation.Devices.Views.DeviceItemView"
             x:DataType="vm:DeviceItemViewModel">

    <Border
        StrokeThickness="1"
        Stroke="#E0E0E0"
        StrokeShape="RoundRectangle 12"
        Padding="16,12"
        Margin="0,4">
        <VerticalStackLayout Spacing="4">
            <Label Text="{Binding Name}"
                   FontAttributes="Bold"
                   FontSize="16" />

            <Label Text="{Binding Address}"
                   FontSize="12"
                   TextColor="Gray" />

            <Label Text="{Binding Status}"
                   FontSize="12"
                   TextColor="#2E7D32" />
        </VerticalStackLayout>
    </Border>

</ContentView>